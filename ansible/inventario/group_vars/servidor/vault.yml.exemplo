---
# Copiar para vault.yml e criptografar (ver README, "Senhas"). Valores no Vaultwarden.
# Senha da pasta do servidor de cada funcionário (mesmo nome de usuarios_samba).
senhas_samba: {}
  # joao.silva: TROCAR

# Token da Cloudflare com "Zone > DNS > Edit" no domínio da empresa (ti_dominio) e
# "Account > Cloudflare Tunnel > Edit": cria os nomes, prova ao Let's Encrypt que o
# domínio é nosso e monta o túnel do MeshCentral.
cloudflare_token: ""
# Senha do banco do GLPI (openssl rand -hex 24).
glpi_banco_senha: ""
